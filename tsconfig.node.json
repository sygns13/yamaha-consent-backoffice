{
  // Archivos que corren en Node: configuración, e2e (Playwright) y tests/ (Vitest en entorno node).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    // DOM: las funciones que los e2e ejecutan en la página (page.evaluate) usan document.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    // vitest.config.ts importa "./vite.config.ts" con extensión (cargador nativo de configuración de Vite).
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.capturas.config.ts", "e2e", "tests"]
}
