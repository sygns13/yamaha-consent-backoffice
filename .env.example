# Variables de build del BackOffice (sección 9.2 del spec). Copiar a .env para `npm run dev`.
# No hay URL de la API: el frontend llama siempre a rutas relativas /api/v1/backoffice/... (mismo origen, sección 2.3).

# Opcional. Texto del distintivo de entorno en la cabecera (p. ej. PRUEBAS en el VPS). Vacío en Producción.
VITE_ENVIRONMENT_LABEL=
